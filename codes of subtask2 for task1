import pybullet as p
import math
import numpy as np
import cv2
import time
from simulation_setup import setup_simulation

# ── Configuration ────────────────────────────────────────────────────────────
CAM_WIDTH = 640
CAM_HEIGHT = 480
CAM_FOV = 60
ASPECT_RATIO = CAM_WIDTH / CAM_HEIGHT
NEAR_PLANE = 0.1
FAR_PLANE = 100.0

lk_params = dict(
    winSize=(15, 15),
    maxLevel=5,
    criteria=(cv2.TERM_CRITERIA_EPS | cv2.TERM_CRITERIA_COUNT, 10, 0.03)
)

feature_params = dict(
    maxCorners=150,
    qualityLevel=0.06,
    minDistance=7,
    blockSize=7
)

ROAD_LOWER = np.array([0, 0, 100])
ROAD_UPPER = np.array([180, 50, 180])

# ── Camera capture ──────────────────────────────────────────────────────────
def get_agent_camera(car_id):
    pos, orn = p.getBasePositionAndOrientation(car_id)
    rot_matrix = np.array(p.getMatrixFromQuaternion(orn)).reshape(3, 3)

    camera_pos = np.array(pos) + rot_matrix.dot([0.6, 0.0, 0.5])
    target_pos = camera_pos + rot_matrix.dot([1.0, 0.0, 0.0])
    up_vector = rot_matrix.dot([0.0, 0.0, 1.0])

    view_matrix = p.computeViewMatrix(camera_pos, target_pos, up_vector)
    proj_matrix = p.computeProjectionMatrixFOV(CAM_FOV, ASPECT_RATIO, NEAR_PLANE, FAR_PLANE)

    _, _, rgbImg, _, _ = p.getCameraImage(CAM_WIDTH, CAM_HEIGHT, view_matrix, proj_matrix,
                                          renderer=p.ER_TINY_RENDERER)

    rgb_array = np.reshape(rgbImg, (CAM_HEIGHT, CAM_WIDTH, 4))
    frame = cv2.cvtColor(rgb_array, cv2.COLOR_RGBA2RGB)
    gray = cv2.cvtColor(frame, cv2.COLOR_RGB2GRAY)
    return frame, gray

# ── Road centre detection ────────────────────────────────────────────────────
def get_road_center(frame):
    hsv = cv2.cvtColor(frame, cv2.COLOR_RGB2HSV)
    mask = cv2.inRange(hsv, ROAD_LOWER, ROAD_UPPER)
    h, w = mask.shape
    bottom_region = mask[int(2*h/3):, :]

    left, right = np.inf, -np.inf
    for col in range(w):
        if np.any(bottom_region[:, col] > 0):
            left = min(left, col)
            right = max(right, col)

    if left == np.inf or right == -np.inf:
        return w // 2
    return (left + right) // 2

# ── Optical flow helpers ─────────────────────────────────────────────────────
def calculate_foe(good_old, good_new):
    vx = good_new[:, 0] - good_old[:, 0]
    vy = good_new[:, 1] - good_old[:, 1]
    mag = np.hypot(vx, vy)
    valid = mag > 0.5
    if valid.sum() < 2:
        return None

    good_old = good_old[valid]
    vx, vy = vx[valid], vy[valid]

    A = np.column_stack((vy, -vx))
    b = good_old[:, 0] * vy - good_old[:, 1] * vx
    try:
        foe, _, _, _ = np.linalg.lstsq(A, b, rcond=None)
        return int(foe[0]), int(foe[1])
    except np.linalg.LinAlgError:
        return None

def calculate_ttc(good_old, good_new, foe):
    if foe is None:
        return np.zeros(len(good_old))
    vx = good_new[:, 0] - good_old[:, 0]
    vy = good_new[:, 1] - good_old[:, 1]
    v_mag = np.hypot(vx, vy)
    dist = np.hypot(good_old[:, 0] - foe[0], good_old[:, 1] - foe[1])
    safe_v = np.where(v_mag == 0, 1e-5, v_mag)
    return dist / safe_v

def filter_dense_clusters(good_old, good_new, patch_size=20, max_points=4):
    keep = np.ones(len(good_old), dtype=bool)
    for i in range(len(good_old)):
        if not keep[i]:
            continue
        px, py = good_old[i]
        neighbours = 0
        for j in range(len(good_old)):
            if i == j:
                continue
            qx, qy = good_old[j]
            if abs(px - qx) < patch_size and abs(py - qy) < patch_size:
                neighbours += 1
        if neighbours > max_points:
            for j in range(len(good_old)):
                qx, qy = good_old[j]
                if abs(px - qx) < patch_size and abs(py - qy) < patch_size:
                    keep[j] = False
    return good_old[keep], good_new[keep]

# ── Goal detection (blue wall) ───────────────────────────────────────────────
def find_goal_centroid(frame):
    hsv = cv2.cvtColor(frame, cv2.COLOR_RGB2HSV)
    mask = cv2.inRange(hsv, np.array([100, 150, 50]), np.array([140, 255, 255]))
    m = cv2.moments(mask)
    if m["m00"] > 500:
        return (int(m["m10"] / m["m00"]), int(m["m01"] / m["m00"]))
    return None

# ── 2D Potential Field (corrected scaling) ──────────────────────────────────
def compute_potential_field(good_old, ttc, foe, goal_point,
                            last_known_goal_x, ttc_threshold=25.0,
                            k_obstacle=25.0, k_goal=0.8):
    """
    Returns (lateral_component, total_x, total_y, list_of_repulsion_vectors)
    where repulsion_vectors contains (x, y, fx, fy) for each obstacle.
    """
    ego_cx = CAM_WIDTH / 2.0
    ego_cy = CAM_HEIGHT / 2.0

    # Repulsive forces
    rep_x, rep_y = 0.0, 0.0
    rep_vectors = []   # for drawing

    if foe is not None:
        for i in range(len(good_old)):
            pt_x, pt_y = good_old[i]
            if pt_y < CAM_HEIGHT * 0.40:   # ignore sky
                continue
            if not (0.1 < ttc[i] < ttc_threshold):
                continue

            # Direction from obstacle to ego (repulsion)
            dir_x = ego_cx - pt_x
            dir_y = ego_cy - pt_y
            norm = np.hypot(dir_x, dir_y)
            if norm < 1e-5:
                continue
            dir_x /= norm
            dir_y /= norm

            proximity_weight = ttc_threshold / (ttc[i] + 1.0)
            proximity_weight = np.clip(proximity_weight, 0.5, 2.0)
            magnitude = np.clip(k_obstacle * proximity_weight, 0, k_obstacle)

            fx = dir_x * magnitude
            fy = dir_y * magnitude
            rep_x += fx
            rep_y += fy
            rep_vectors.append((pt_x, pt_y, fx, fy))

    # Attractive force toward goal (correct scaling)
    if goal_point is not None:
        goal_x, goal_y = goal_point
    else:
        goal_x = last_known_goal_x
        goal_y = ego_cy

    attr_dir_x = goal_x - ego_cx
    attr_dir_y = goal_y - ego_cy
    norm = np.hypot(attr_dir_x, attr_dir_y)
    if norm > 1e-5:
        attr_dir_x /= norm
        attr_dir_y /= norm

    # Scale attraction to be comparable to repulsion (max ~ k_goal * image_width/2)
    # Use k_goal * (CAM_WIDTH/2) as max magnitude, similar to agv2's goal influence
    max_attr_mag = k_goal * (CAM_WIDTH / 2.0)
    attr_x = attr_dir_x * max_attr_mag
    attr_y = attr_dir_y * max_attr_mag

    total_x = rep_x + attr_x
    total_y = rep_y + attr_y

    # Lateral component normalized to [-1, 1] for steering
    lateral = np.clip(total_x / (CAM_WIDTH / 2.0), -1.0, 1.0)

    return lateral, total_x, total_y, rep_vectors

# ── Steering and speed (using potential field) ───────────────────────────────
def compute_steering_and_speed(foe, good_old, ttc, goal_point, last_known_goal_x,
                               road_center_error, k_obstacle=25.0, k_road=1.2,
                               k_goal=0.8, ttc_threshold=25.0, max_steer=0.7):
    """
    Returns (steering, speed, lateral_field, rep_vectors)
    """
    lateral_field, _, _, rep_vectors = compute_potential_field(
        good_old, ttc, foe, goal_point, last_known_goal_x,
        ttc_threshold, k_obstacle, k_goal
    )

    lateral_road = -k_road * road_center_error
    total_lateral = lateral_field + lateral_road   # removed extra 1.5 multiplier
    steering = np.clip(total_lateral, -max_steer, max_steer)

    # Speed control – copied from working agv2.py
    if len(ttc) > 0:
        valid_ttc = ttc[(ttc > 0) & (ttc < 150)]
        if len(valid_ttc) > 0:
            min_ttc = np.min(valid_ttc)
            if min_ttc < 80:
                speed = 4.0
            elif min_ttc < 150:
                speed = 6.0
            else:
                speed = 12.0
        else:
            speed = 15.0
    else:
        speed = 15.0

    return steering, speed * 3.0, lateral_field, rep_vectors   # scale speed as in agv2

# ── Main loop with vector drawing ────────────────────────────────────────────
def main():
    print("Initialising simulation …")
    car_id, steering_joints, motor_joints = setup_simulation(gui=True)

    _, old_gray = get_agent_camera(car_id)
    p0 = cv2.goodFeaturesToTrack(old_gray, mask=None, **feature_params)

    mask_img = np.zeros((CAM_HEIGHT, CAM_WIDTH, 3), dtype=np.uint8)
    last_known_goal_x = CAM_WIDTH / 2.0

    print("Starting navigation … Press ESC to quit.")

    try:
        while True:
            p.stepSimulation()
            frame, frame_gray = get_agent_camera(car_id)

            # Goal check
            car_pos, _ = p.getBasePositionAndOrientation(car_id)
            if car_pos[0] >= 30.0:
                print("Goal reached!")
                break

            # Road centering
            road_center = get_road_center(frame)
            road_center_error = (road_center - CAM_WIDTH/2) / (CAM_WIDTH/2)
            cv2.circle(frame, (road_center, CAM_HEIGHT-30), 8, (0, 255, 0), -1)

            # Goal detection
            goal_point = find_goal_centroid(frame)
            if goal_point:
                cv2.circle(frame, goal_point, 10, (255, 0, 255), -1)
                last_known_goal_x = goal_point[0]
            else:
                cv2.circle(frame, (int(last_known_goal_x), CAM_HEIGHT//2),
                           10, (100, 0, 100), 2)

            # Optical flow
            if p0 is None or len(p0) < 10:
                p0 = cv2.goodFeaturesToTrack(frame_gray, mask=None, **feature_params)
                old_gray = frame_gray.copy()
                time.sleep(1./60.)
                continue

            p1, st, _ = cv2.calcOpticalFlowPyrLK(old_gray, frame_gray, p0, None, **lk_params)

            if p1 is not None and st is not None:
                good_new = p1[st == 1]
                good_old = p0[st == 1]

                if len(good_old) > 0:
                    good_old, good_new = filter_dense_clusters(good_old, good_new, patch_size=20, max_points=4)

                if len(good_old) < 3:
                    old_gray = frame_gray.copy()
                    p0 = cv2.goodFeaturesToTrack(frame_gray, mask=None, **feature_params)
                    time.sleep(1./60.)
                    continue

                foe = calculate_foe(good_old, good_new)
                ttc = calculate_ttc(good_old, good_new, foe)

                # Compute steering & speed (now returns lateral_field and rep_vectors)
                steering, speed, lateral_field, rep_vectors = compute_steering_and_speed(
                    foe, good_old, ttc, goal_point, last_known_goal_x,
                    road_center_error, k_obstacle=25.0, k_road=1.2,
                    k_goal=0.8, ttc_threshold=25.0, max_steer=0.7
                )

                # Post‑avoidance recovery (same as agv2)
                if not hasattr(main, '_avoid_state'):
                    main._avoid_state = {'avoiding': False, 'recovery_frames': 0}
                state = main._avoid_state

                if abs(steering) > 0.3:
                    state['avoiding'] = True
                    state['recovery_frames'] = 45
                elif state['avoiding']:
                    state['avoiding'] = False
                    p0 = cv2.goodFeaturesToTrack(frame_gray, mask=None, **feature_params)
                    old_gray = frame_gray.copy()

                if state['recovery_frames'] > 0:
                    state['recovery_frames'] -= 1

                k_road_active = 3.5 if state['recovery_frames'] > 0 else 1.2
                # Recompute with increased road gain during recovery
                steering, speed, lateral_field, rep_vectors = compute_steering_and_speed(
                    foe, good_old, ttc, goal_point, last_known_goal_x,
                    road_center_error, k_obstacle=25.0, k_road=k_road_active,
                    k_goal=0.8, ttc_threshold=25.0, max_steer=0.7
                )

                # Apply controls
                for j in steering_joints:
                    p.setJointMotorControl2(car_id, j, p.POSITION_CONTROL, targetPosition=steering)
                for j in motor_joints:
                    p.setJointMotorControl2(car_id, j, p.VELOCITY_CONTROL, targetVelocity=speed, force=1000.0)

                # ── Visualisation ─────────────────────────────────────────────
                # Flow vectors
                mask_img = (mask_img * 0.85).astype(np.uint8)
                for i, (new, old) in enumerate(zip(good_new, good_old)):
                    a, b = int(new[0]), int(new[1])
                    c, d = int(old[0]), int(old[1])
                    color = (0, 0, 255) if ttc[i] < 80 else (0, 255, 0)
                    mask_img = cv2.line(mask_img, (a, b), (c, d), color, 1)
                    frame = cv2.circle(frame, (a, b), 3, color, -1)

                # Draw potential field vectors (repulsion arrows + net vector)
                # 1. Per‑obstacle repulsion arrows (scaled for visibility)
                for (px, py, fx, fy) in rep_vectors:
                    # Scale arrow length (magnitude already in pixels? fx is in pixel units)
                    end_x = int(px + fx * 0.5)   # scale factor to keep arrow on screen
                    end_y = int(py + fy * 0.5)
                    cv2.arrowedLine(frame, (int(px), int(py)), (end_x, end_y),
                                    (0, 255, 255), 1, tipLength=0.3)

                # 2. Net potential field vector (from image center)
                # Recompute net vector (total_x, total_y) for drawing
                _, total_x, total_y, _ = compute_potential_field(
                    good_old, ttc, foe, goal_point, last_known_goal_x,
                    ttc_threshold=25.0, k_obstacle=25.0, k_goal=0.8
                )
                center = (CAM_WIDTH // 2, CAM_HEIGHT // 2)
                net_end = (int(center[0] + total_x * 0.3), int(center[1] + total_y * 0.3))
                cv2.arrowedLine(frame, center, net_end, (255, 0, 255), 2, tipLength=0.4)
                cv2.putText(frame, "Net Field", (net_end[0]+5, net_end[1]), 
                            cv2.FONT_HERSHEY_SIMPLEX, 0.4, (255, 0, 255), 1)

                # FOE
                if foe is not None:
                    foe_x = np.clip(foe[0], 0, CAM_WIDTH-1)
                    foe_y = np.clip(foe[1], 0, CAM_HEIGHT-1)
                    cv2.drawMarker(frame, (int(foe_x), int(foe_y)), (255, 0, 0),
                                   markerType=cv2.MARKER_CROSS, markerSize=20, thickness=2)

                # Text overlay
                cv2.putText(frame, f"Steering: {steering:.2f} rad", (10, 30),
                            cv2.FONT_HERSHEY_SIMPLEX, 0.5, (255,255,255), 1)
                cv2.putText(frame, f"Speed: {speed:.1f} m/s", (10, 50),
                            cv2.FONT_HERSHEY_SIMPLEX, 0.5, (255,255,255), 1)
                cv2.putText(frame, f"Road error: {road_center_error:.2f}", (10, 70),
                            cv2.FONT_HERSHEY_SIMPLEX, 0.5, (255,255,255), 1)
                cv2.putText(frame, f"Lateral field: {lateral_field:.2f}", (10, 90),
                            cv2.FONT_HERSHEY_SIMPLEX, 0.5, (255,255,255), 1)

                out_img = cv2.add(frame, mask_img)
                cv2.imshow('Autonomous Navigation (Potential Field + Vectors)', out_img)

                old_gray = frame_gray.copy()
                p0 = good_new.reshape(-1, 1, 2)

            if cv2.waitKey(1) & 0xFF == 27:
                break

            time.sleep(1./60.)

    except KeyboardInterrupt:
        pass
    finally:
        cv2.destroyAllWindows()
        p.disconnect()
        print("Simulation ended.")

if __name__ == '__main__':
    main()
  
