import pybullet as p
import math
import numpy as np
import cv2
import time
from simulation_setup import setup_simulation

# ── Configuration ────────────────────────────────────────────────────────────
CAM_WIDTH = 640
CAM_HEIGHT = 480
CAM_FOV = 60
ASPECT_RATIO = CAM_WIDTH / CAM_HEIGHT
NEAR_PLANE = 0.1
FAR_PLANE = 100.0

# Lucas‑Kanade parameters (from OpenCV documentation)
lk_params = dict(
    winSize=(15, 15),
    maxLevel=5,
    criteria=(cv2.TERM_CRITERIA_EPS | cv2.TERM_CRITERIA_COUNT, 10, 0.03)
)

# Shi‑Tomasi feature detector parameters
feature_params = dict(
    maxCorners=150,          # more points = better obstacle detection
    qualityLevel=0.06,
    minDistance=7,
    blockSize=7
)

# Road segmentation thresholds (HSV) – tune if track colour changes
ROAD_LOWER = np.array([0, 0, 100])      # low saturation, medium brightness
ROAD_UPPER = np.array([180, 50, 180])   # grey tones

# ── Camera capture (same as original) ────────────────────────────────────────


def get_agent_camera(car_id):
    """
    Capture RGB and grayscale frames from the car's forward camera.
    Returns (rgb_frame, gray_frame).
    """
    pos, orn = p.getBasePositionAndOrientation(car_id)
    rot_matrix = np.array(p.getMatrixFromQuaternion(orn)).reshape(3, 3)

    camera_pos = np.array(pos) + rot_matrix.dot([0.6, 0.0, 0.5])
    target_pos = camera_pos + rot_matrix.dot([1.0, 0.0, 0.0])
    up_vector = rot_matrix.dot([0.0, 0.0, 1.0])

    view_matrix = p.computeViewMatrix(camera_pos, target_pos, up_vector)
    proj_matrix = p.computeProjectionMatrixFOV(
        CAM_FOV, ASPECT_RATIO, NEAR_PLANE, FAR_PLANE)

    _, _, rgbImg, _, _ = p.getCameraImage(
        CAM_WIDTH, CAM_HEIGHT, view_matrix, proj_matrix,
        renderer=p.ER_TINY_RENDERER)

    rgb_array = np.reshape(rgbImg, (CAM_HEIGHT, CAM_WIDTH, 4))
    frame = cv2.cvtColor(rgb_array, cv2.COLOR_RGBA2RGB)
    gray = cv2.cvtColor(frame, cv2.COLOR_RGB2GRAY)
    return frame, gray

# ── Road centre detection (vision‑based lane keeping) ────────────────────────


def get_road_center(frame):
    """
    Return the x‑coordinate (pixel) of the road centre at the bottom of the image.
    Uses colour thresholding to isolate the road.
    """
    hsv = cv2.cvtColor(frame, cv2.COLOR_RGB2HSV)
    mask = cv2.inRange(hsv, ROAD_LOWER, ROAD_UPPER)

    # Only consider the bottom 1/3 of the image (where the road is clearly visible)
    h, w = mask.shape
    bottom_region = mask[int(2*h/3):, :]

    # Find leftmost and rightmost road pixels
    left = np.inf
    right = -np.inf
    for col in range(w):
        if np.any(bottom_region[:, col] > 0):
            if col < left:
                left = col
            if col > right:
                right = col

    if left == np.inf or right == -np.inf:   # no road detected → fallback
        return w // 2

    road_center = (left + right) // 2
    return road_center

# ── Optical flow helpers (same as original) ──────────────────────────────────


def calculate_foe(good_old, good_new):
    """Compute Focus of Expansion (FOE) via least squares."""
    vx = good_new[:, 0] - good_old[:, 0]
    vy = good_new[:, 1] - good_old[:, 1]
    mag = np.hypot(vx, vy)

    valid = mag > 0.5
    if valid.sum() < 2:
        return None

    good_old = good_old[valid]
    vx, vy = vx[valid], vy[valid]

    A = np.column_stack((vy, -vx))
    b = good_old[:, 0] * vy - good_old[:, 1] * vx

    try:
        foe, _, _, _ = np.linalg.lstsq(A, b, rcond=None)
        return int(foe[0]), int(foe[1])
    except np.linalg.LinAlgError:
        return None


def calculate_ttc(good_old, good_new, foe):
    """Time‑to‑contact = distance to FOE / flow magnitude."""
    if foe is None:
        return np.zeros(len(good_old))

    vx = good_new[:, 0] - good_old[:, 0]
    vy = good_new[:, 1] - good_old[:, 1]
    v_mag = np.hypot(vx, vy)
    dist = np.hypot(good_old[:, 0] - foe[0], good_old[:, 1] - foe[1])

    safe_v = np.where(v_mag == 0, 1e-5, v_mag)
    return dist / safe_v


def filter_dense_clusters(good_old, good_new, patch_size=20, max_points=4):
    """
    Remove points that are densely clustered in a small patch.
    These are often road markings, not real obstacles.
    """
    keep = np.ones(len(good_old), dtype=bool)

    for i in range(len(good_old)):
        if not keep[i]:
            continue
        px, py = good_old[i]

        neighbours = 0
        for j in range(len(good_old)):
            if i == j:
                continue
            qx, qy = good_old[j]
            if abs(px - qx) < patch_size and abs(py - qy) < patch_size:
                neighbours += 1

        if neighbours > max_points:
            # Remove all points in this cluster
            for j in range(len(good_old)):
                qx, qy = good_old[j]
                if abs(px - qx) < patch_size and abs(py - qy) < patch_size:
                    keep[j] = False

    return good_old[keep], good_new[keep]

# ── Goal detection (blue wall) ───────────────────────────────────────────────


def find_goal_centroid(frame):
    """Detect the blue end‑wall and return its centroid (x,y)."""
    hsv = cv2.cvtColor(frame, cv2.COLOR_RGB2HSV)
    mask = cv2.inRange(hsv, np.array(
        [100, 150, 50]), np.array([140, 255, 255]))
    m = cv2.moments(mask)
    if m["m00"] > 500:
        return (int(m["m10"] / m["m00"]), int(m["m01"] / m["m00"]))
    return None

# ── Steering and speed controller (vision‑only) ──────────────────────────────


def compute_steering_and_speed(
    foe, good_old, ttc, goal_point, last_known_goal_x,
    road_center_error,      # normalized road offset from image centre
    # Gains (tunable)
    k_obstacle=25.0,         # repulsion strength
    k_road=0.0,             # road centering gain
    k_goal=0.8,             # goal attraction
    ttc_threshold=17.5,      # only react to obstacles with TTC < this
    max_steer=0.7           # max steering angle (radians)
):
    """
    Compute steering angle (radians) and target speed (m/s) using only visual cues.
    Returns (steering, speed).
    """
    ego_cx = CAM_WIDTH / 2.0

    # 1. Obstacle avoidance: lateral push from low‑TTC features
    # 1. Obstacle avoidance: constant lateral push for all points within threshold
    lateral_obstacle = 0.0
    if foe is not None and len(good_old) > 0:
        for i in range(len(good_old)):
            pt_x, pt_y = good_old[i]
            if pt_y < CAM_HEIGHT * 0.40:   # ignore sky (top 40%)
                continue
            if 0 < ttc[i] < ttc_threshold:
                lateral_px = (pt_x - ego_cx) / ego_cx
                if abs(lateral_px) < 0.15:   # head-on obstacle
                    foe_side = 1.0 if (foe[0] < ego_cx) else -1.0
                    force = foe_side * k_obstacle * 0.5
                else:
                    force = -lateral_px * k_obstacle
                proximity_weight = ttc_threshold / (ttc[i] + 1.0)
                proximity_weight = np.clip(proximity_weight, 0.5, 2.0)
                point_force = np.clip(
                    force * proximity_weight, -k_obstacle, k_obstacle)  # cap per-point
                lateral_obstacle += point_force

    # 2. Road centering (vision‑based)
    lateral_road = -k_road * road_center_error

    # 3. Goal attraction — suppressed when actively dodging
    avoidance_active = abs(lateral_obstacle) > 0.3
    lateral_goal = 0.0
    if goal_point is not None:
        goal_err = (goal_point[0] - ego_cx) / ego_cx
        goal_weight = 0.15 if avoidance_active else k_goal
        lateral_goal = goal_weight * goal_err
    else:
        goal_err = (last_known_goal_x - ego_cx) / ego_cx
        goal_weight = 0.1 if avoidance_active else k_goal * 0.5
        lateral_goal = goal_weight * goal_err

    total_lateral = (lateral_obstacle + lateral_road + lateral_goal)*1.5
    # Add just before:  steering = np.clip(...)
    print(
        f"  obstacle={lateral_obstacle:.3f}  road={lateral_road:.3f}  goal={lateral_goal:.3f}  net={total_lateral:.3f}")
    steering = np.clip(total_lateral, -max_steer, max_steer)

    # 4. Speed control based on minimum TTC
    if len(ttc) > 0:
        valid_ttc = ttc[(ttc > 0) & (ttc < 150)]
        if len(valid_ttc) > 0:
            min_ttc = np.min(valid_ttc)
            if min_ttc < 80:
                speed = 4.0
            elif min_ttc < 150:
                speed = 6.0
            else:
                speed = 12.0
        else:
            speed = 15.0
    else:
        speed = 15.0

    return steering, speed*3

# ── Main loop ─────────────────────────────────────────────────────────────────


def main():
    print("Initialising simulation …")
    car_id, steering_joints, motor_joints = setup_simulation(gui=True)

    _, old_gray = get_agent_camera(car_id)
    p0 = cv2.goodFeaturesToTrack(old_gray, mask=None, **feature_params)

    mask_img = np.zeros((CAM_HEIGHT, CAM_WIDTH, 3), dtype=np.uint8)
    last_known_goal_x = CAM_WIDTH / 2.0

    print("Starting navigation …  Press ESC to quit.")

    try:
        while True:
            p.stepSimulation()
            # Capture frame
            frame, frame_gray = get_agent_camera(car_id)

            # ── Check goal (simple x‑distance in simulation, but you can remove this) ──
            car_pos, _ = p.getBasePositionAndOrientation(car_id)
            if car_pos[0] >= 30.0:
                print("Goal reached!")
                break

            # ── Vision‑based road centering ──────────────────────────────────────
            road_center = get_road_center(frame)
            road_center_error = (road_center - CAM_WIDTH/2) / (CAM_WIDTH/2)
            # Draw road centre for debugging
            cv2.circle(frame, (road_center, CAM_HEIGHT-30), 8, (0, 255, 0), -1)

            # ── Goal detection ───────────────────────────────────────────────────
            goal_point = find_goal_centroid(frame)
            if goal_point:
                cv2.circle(frame, goal_point, 10, (255, 0, 255), -1)
                last_known_goal_x = goal_point[0]
            else:
                # Show last known goal position
                cv2.circle(frame, (int(last_known_goal_x), CAM_HEIGHT//2),
                           10, (100, 0, 100), 2)

            # ── Sparse optical flow ─────────────────────────────────────────────
            # Refresh features if too few
            if p0 is None or len(p0) < 10:
                p0 = cv2.goodFeaturesToTrack(
                    frame_gray, mask=None, **feature_params)
                old_gray = frame_gray.copy()
                time.sleep(1./60.)
                continue

            p1, st, _ = cv2.calcOpticalFlowPyrLK(
                old_gray, frame_gray, p0, None, **lk_params)

            if p1 is not None and st is not None:
                good_new = p1[st == 1]
                good_old = p0[st == 1]

                if len(good_old) > 0:
                    # Remove dense clusters (road markings)
                    good_old, good_new = filter_dense_clusters(
                        good_old, good_new, patch_size=20, max_points=4)

                if len(good_old) < 3:
                    old_gray = frame_gray.copy()
                    p0 = cv2.goodFeaturesToTrack(
                        frame_gray, mask=None, **feature_params)
                    time.sleep(1./60.)
                    continue

                foe = calculate_foe(good_old, good_new)
                ttc = calculate_ttc(good_old, good_new, foe)
                positive_ttc = ttc[ttc > 0]
                if len(positive_ttc) > 0:
                    print(
                        f"Min TTC: {positive_ttc.min():.1f} Max TTC: {positive_ttc.max():.1f}")
                else:
                    print("No positive TTC values")

                # ── Compute steering and speed (vision‑only) ──────────────────────

                steering, speed = compute_steering_and_speed(
                    foe, good_old, ttc, goal_point, last_known_goal_x,
                    road_center_error,
                    k_obstacle=25.0, k_road=1.2, k_goal=0.8, ttc_threshold=15.0, max_steer=0.7)

                # ── Post-avoidance road recentering ──────────────────────────
                if not hasattr(main, '_avoid_state'):
                    main._avoid_state = {
                        'avoiding': False, 'recovery_frames': 0}

                state = main._avoid_state

                if abs(steering) > 0.3:
                    state['avoiding'] = True
                    state['recovery_frames'] = 45
                elif state['avoiding']:
                    state['avoiding'] = False
                    p0 = cv2.goodFeaturesToTrack(
                        frame_gray, mask=None, **feature_params)
                    old_gray = frame_gray.copy()

                if state['recovery_frames'] > 0:
                    state['recovery_frames'] -= 1

                k_road_active = 3.5 if state['recovery_frames'] > 0 else 1.2

                # Recompute steering with updated k_road
                steering, speed = compute_steering_and_speed(
                    foe, good_old, ttc, goal_point, last_known_goal_x,
                    road_center_error,
                    k_obstacle=25.0, k_road=k_road_active, k_goal=0.8, ttc_threshold=25.0)
                # ─────────────────────────────────────────────────────────────

                # Apply steering and speed
                for j in steering_joints:
                    p.setJointMotorControl2(car_id, j, p.POSITION_CONTROL,
                                            targetPosition=steering)
                for j in motor_joints:
                    p.setJointMotorControl2(car_id, j, p.VELOCITY_CONTROL,
                                            targetVelocity=speed, force=1000.0)

                # ── Visualisation ─────────────────────────────────────────────────
                # Draw flow vectors
                mask_img = (mask_img * 0.85).astype(np.uint8)
                for i, (new, old) in enumerate(zip(good_new, good_old)):
                    a, b = int(new[0]), int(new[1])
                    c, d = int(old[0]), int(old[1])
                    color = (0, 0, 255) if ttc[i] < 80 else (0, 255, 0)
                    mask_img = cv2.line(mask_img, (a, b), (c, d), color, 1)
                    frame = cv2.circle(frame, (a, b), 3, color, -1)

                # Draw FOE if available
                if foe is not None:
                    foe_x = np.clip(foe[0], 0, CAM_WIDTH-1)
                    foe_y = np.clip(foe[1], 0, CAM_HEIGHT-1)
                    cv2.drawMarker(frame, (int(foe_x), int(foe_y)), (255, 0, 0),
                                   markerType=cv2.MARKER_CROSS,
                                   markerSize=20, thickness=2)

                # Overlay steering and speed info
                cv2.putText(frame, f"Steering: {steering:.2f} rad", (10, 30),
                            cv2.FONT_HERSHEY_SIMPLEX, 0.5, (255, 255, 255), 1)
                cv2.putText(frame, f"Speed: {speed:.1f} m/s", (10, 50),
                            cv2.FONT_HERSHEY_SIMPLEX, 0.5, (255, 255, 255), 1)
                cv2.putText(frame, f"Road error: {road_center_error:.2f}", (10, 70),
                            cv2.FONT_HERSHEY_SIMPLEX, 0.5, (255, 255, 255), 1)

                # Combine frame and flow mask
                out_img = cv2.add(frame, mask_img)
                cv2.imshow('Autonomous Navigation (Vision Only)', out_img)

                # Update for next iteration
                old_gray = frame_gray.copy()
                p0 = good_new.reshape(-1, 1, 2)

            # Quit on ESC
            if cv2.waitKey(1) & 0xFF == 27:
                break

            time.sleep(1./60.)   # ~60 fps

    except KeyboardInterrupt:
        pass
    finally:
        cv2.destroyAllWindows()
        p.disconnect()
        print("Simulation ended.")


if __name__ == '__main__':
    main()





